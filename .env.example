# -----------------------------
# App
# -----------------------------
APP_NAME="Claude Agent Queue API"
LOG_LEVEL="INFO"
LOG_DIR="logs"
DEBUG_LOG_ENABLED="true"
DEBUG_LOG_BACKUP_DAYS="14"
DEBUG_LOG_FILENAME="debug.log"
DEBUG_LOG_UTC="true"
QUEUES_CONFIG_PATH="config/queues.yaml"
BACKEND_PORT="18000"
FRONTEND_HOST="0.0.0.0"
FRONTEND_PORT="18080"

# -----------------------------
# Database (SQLite or MySQL)
# -----------------------------
# SQLite example:
DATABASE_URL="sqlite:///./cc_fastapi.db"
# MySQL example:
# DATABASE_URL="mysql+pymysql://user:password@127.0.0.1:3306/cc_fastapi"
# External Postgres (if set, this overrides DATABASE_URL):
# POSTGRES_EXTERNAL_URL="postgresql+psycopg://user:password@host:5432/cc_fastapi"
POSTGRES_EXTERNAL_URL=""

# -----------------------------
# Claude / Agent SDK
# -----------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://aihubmix.com"
API_TIMEOUT_MS="3000000"
ANTHROPIC_DEFAULT_OPUS_MODEL="claude-sonnet-4-5"
ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-4-5"
ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ClaudeAgentOptions mapping
CLAUDE_PERMISSION_MODE="bypassPermissions"
CLAUDE_MAX_TURNS="16"
CLAUDE_CWD="."
# JSON array string preferred, e.g. '["Read","Edit","Bash"]'
CLAUDE_ALLOWED_TOOLS='["Read", "Edit", "Write", "Grep", "Glob"]'
CLAUDE_DISALLOWED_TOOLS="[]"

# -----------------------------
# Worker / Queue policy
# -----------------------------
WORKER_CONCURRENCY="1"
POLL_INTERVAL_MS="1000"
QUEUE_TTL_HOURS="24"
RUNNING_TTL_HOURS="4"
MAX_ATTEMPTS="3"

# -----------------------------
# API auth (optional)
# -----------------------------
# If empty, token auth is disabled.
API_TOKEN=""

# -----------------------------
# Independent review console
# -----------------------------
REVIEW_CONSOLE_API_TOKEN=""
REVIEW_CONSOLE_SESSION_SECRET=""
REVIEW_CONSOLE_SESSION_HOURS="12"
REVIEW_CONSOLE_COOKIE_SECURE="false"
REVIEW_CONSOLE_ADMIN_USERNAME="admin"
REVIEW_CONSOLE_ADMIN_PASSWORD=""

# Local password login can be disabled after OIDC SSO has been verified.
REVIEW_CONSOLE_LOCAL_LOGIN_ENABLED="true"
REVIEW_CONSOLE_SSO_ENABLED="false"
REVIEW_CONSOLE_SSO_ISSUER_URL="https://id.example.com/realms/company"
REVIEW_CONSOLE_SSO_CLIENT_ID="review-console"
REVIEW_CONSOLE_SSO_CLIENT_SECRET=""
# client_secret_basic, client_secret_post, or none
REVIEW_CONSOLE_SSO_CLIENT_AUTH_METHOD="client_secret_basic"
# Must be registered exactly at the identity provider.
REVIEW_CONSOLE_SSO_REDIRECT_URI="https://review.example.com/api/v1/auth/sso/callback"
REVIEW_CONSOLE_SSO_SCOPES="openid profile email"
REVIEW_CONSOLE_SSO_SIGNING_ALGORITHMS="RS256"
REVIEW_CONSOLE_SSO_USERNAME_CLAIM="preferred_username"
REVIEW_CONSOLE_SSO_DISPLAY_NAME_CLAIM="name"
REVIEW_CONSOLE_SSO_GROUPS_CLAIM="groups"
# Optional: members of this exact IdP group become console administrators.
REVIEW_CONSOLE_SSO_ADMIN_GROUP=""
REVIEW_CONSOLE_SSO_BUTTON_LABEL="使用企业账号登录"
REVIEW_CONSOLE_SSO_TIMEOUT_SECONDS="10"

# -----------------------------
# GitLab webhook
# -----------------------------
# Compared with X-Gitlab-Token. If empty, webhook token auth is disabled.
GITLAB_WEBHOOK_SECRET=""
# The Jinja file exposes payload fields at top level, plus payload, event_type and webhook.
GITLAB_WEBHOOK_PROMPT_TEMPLATE_PATH="config/templates/gitlab_webhook_prompt.j2"
# If empty, the configured default queue is used.
GITLAB_WEBHOOK_QUEUE_NAME=""
# If empty, the target queue's default_model is used, then ANTHROPIC_MODEL.
GITLAB_WEBHOOK_MODEL=""

# -----------------------------
# GitHub webhook
# -----------------------------
# Used to verify X-Hub-Signature-256. If empty, webhook signature auth is disabled.
GITHUB_WEBHOOK_SECRET=""
# The Jinja context matches the GitLab template: payload fields, payload, event_type and webhook.
GITHUB_WEBHOOK_PROMPT_TEMPLATE_PATH="config/templates/github_webhook_prompt.j2"
# If empty, the configured default queue is used.
GITHUB_WEBHOOK_QUEUE_NAME=""
# If empty, the target queue's default_model is used, then ANTHROPIC_MODEL.
GITHUB_WEBHOOK_MODEL=""
